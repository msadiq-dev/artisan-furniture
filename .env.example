# Bank account name displayed on order confirmation and bank transfer checkout
NEXT_PUBLIC_BANK_NAME="Demo Bank Ltd"

# Bank account title for customer wire transfers
NEXT_PUBLIC_BANK_ACCOUNT_TITLE="Demo Account Title"

# Bank account number for wire transfers
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="0000-0000000-00"

# International Bank Account Number (IBAN) for bank payments
NEXT_PUBLIC_BANK_IBAN="PK00DEMO0000000000000000"

# Bank branch location or description
NEXT_PUBLIC_BANK_BRANCH="Demo Branch"

# Showroom and workshop physical address shown in header, footer, and contact page
NEXT_PUBLIC_SHOP_ADDRESS="Plot 00, Demo Industrial Area, Karachi, Pakistan"

# Store phone and WhatsApp contact number
NEXT_PUBLIC_SHOP_PHONE="+92 300 0000000"

# Official customer support and inquiry email address
NEXT_PUBLIC_SHOP_EMAIL="hello@example.com"

# Canonical base URL of the storefront
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public Supabase project URL (from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public Supabase Anonymous Key (leave empty in repository; configure in .env.local)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase Service Role Key (NEVER expose to browser; configure in .env.local)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n webhook URL for new order notifications (optional)
N8N_ORDER_WEBHOOK_URL=

# Server-only n8n webhook URL for invoice processing automation (optional)
N8N_INVOICE_WEBHOOK_URL=

# Server-only shared secret for verifying inbound and outbound n8n webhook payloads (optional)
N8N_WEBHOOK_SECRET=